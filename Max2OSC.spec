# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for Max2OSC.

    .venv/bin/pyinstaller Max2OSC.spec

Builds dist/Max2OSC.app on macOS and dist/Max2OSC/ on Windows and Linux.
PyInstaller cannot cross-compile: build each platform on that platform.

The Maxwell's head-tracking interface is a vendor HID page, so unlike a
keyboard or Bluetooth device it needs no privacy permission or usage string.
"""
import os
import sys

hidden = ["hid"]
if sys.platform == "darwin":
    hidden += ["objc", "AppKit", "Foundation"]      # menu bar extra

# Icons are generated by ./make_icons.sh and committed. Missing files are
# tolerated: a build without an icon is better than no build.
ICON_WIN = "Max2OSC.ico" if os.path.exists("Max2OSC.ico") else None
ICON_MAC = "Max2OSC.icns" if os.path.exists("Max2OSC.icns") else None
ICON_EXE = ICON_MAC if sys.platform == "darwin" else ICON_WIN

DATAS = [(f, ".") for f in ("icon_256.png", "profiles.txt",
                            "menubar_idle.png", "menubar_active.png")
         if os.path.exists(f)]

a = Analysis(
    ["max2osc.py"],
    pathex=[],
    binaries=[],
    datas=DATAS,
    hiddenimports=hidden,
    hookspath=[],
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="Max2OSC",
    icon=ICON_EXE,
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,          # GUI app: no terminal window
    argv_emulation=False,
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name="Max2OSC",
)
app = BUNDLE(
    coll,
    name="Max2OSC.app",
    icon=ICON_MAC,
    bundle_identifier="cc.wagner.max2osc",
    version="0.1.0",
    info_plist={
        "CFBundleName": "Max2OSC",
        "CFBundleDisplayName": "Max2OSC",
        "CFBundleShortVersionString": "0.1.0",
        "CFBundleVersion": "0.1.0",
        "LSMinimumSystemVersion": "11.0",
        "LSApplicationCategoryType": "public.app-category.utilities",
        "NSHighResolutionCapable": True,
        "NSHumanReadableCopyright": "Protocol reverse engineered for interoperability.",
    },
)
